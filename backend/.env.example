# Copiar a .env y completar con las credenciales del proyecto de Supabase.
# El archivo .env esta en .gitignore: NUNCA subir las claves al repositorio.

SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co

# Clave publicable. Se usa solo para autenticacion.
SUPABASE_KEY=sb_publishable_XXXXXXXXXXXX

# Clave secreta. Saltea las politicas de RLS, asi que vive UNICAMENTE en el
# backend y jamas debe llegar al navegador.
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXXXXXX
