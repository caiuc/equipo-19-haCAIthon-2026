#!/bin/sh
# Impide commitear marcadores de conflicto sin resolver.
#
# Durante el desarrollo se commitearon marcadores <<<<<<< en backend/main.py
# dos veces, y cada vez el backend dejo de arrancar para todo el equipo sin que
# nadie se enterara hasta minutos despues.
#
# Instalar con:  git config core.hooksPath .githooks

if git diff --cached --name-only --diff-filter=ACM \
  | xargs -r grep -lE '^(<<<<<<<|>>>>>>>) ' 2>/dev/null | grep -q .; then

  echo ""
  echo "  COMMIT BLOQUEADO: hay marcadores de conflicto sin resolver en:"
  echo ""
  git diff --cached --name-only --diff-filter=ACM \
    | xargs -r grep -lE '^(<<<<<<<|>>>>>>>) ' 2>/dev/null \
    | sed 's/^/    /'
  echo ""
  echo "  Resuelvelos y vuelve a intentar."
  echo ""
  exit 1
fi

exit 0
